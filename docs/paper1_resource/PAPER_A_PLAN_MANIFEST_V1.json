 "banned_assertions": [
  {
   "pattern": "\\bverdict\\s*:\\s*\"?PHYSICAL\\b",
   "why": "NUM-TIME-01 is numerical-model-structural; physical validity is untested"
  },
  {
   "pattern": "\\ball local rate information\\b",
   "why": "true only in the declared weighted-L2 surrogate geometry, not for the production MAPE objective"
  },
  {
   "pattern": "\\bRATE RECALIBRATION ALONE\\b",
   "why": "M0-M2 is an estimation-policy contrast; the inventory level is re-profiled under each policy"
  },
  {
   "pattern": "\\bhydraulic attribution\\b",
   "why": "M1-M2 is an input substitution; particle geometry was frozen and never varied"
  },
  {
   "pattern": "\\bcannot localize\\b",
   "why": "categorical; classification depends on J_inf and an operational tolerance"
  },
  {
   "pattern": "\\bfreeze rather than fit\\b",
   "why": "the universal policy rule was withdrawn"
  },
  {
   "pattern": "\\bfreezing the rate transfers better\\b",
   "why": "pooled sign is not stable and the coarse/fine directions oppose"
  },
  {
   "pattern": "\\bunbounded above\\b",
   "why": "the acceptable set is right-censored at kappa=500, not proven unbounded"
  },
  {
   "pattern": "\\btwo (?:well-chosen )?conditions beat all nine\\b",
   "why": "false on total sensitivity spread; the grid carries 1.8x more"
  },
  {
   "pattern": "\\bcannot see the kinetics\\b",
   "why": "categorical, and pre-empts P0-G8; the response becomes weakly sensitive, which is not the same claim"
  },
  {
   "pattern": "\\bSATURATING_DEGENERACY\\b",
   "why": "verdict framing predating the H1 tail classification; P0-G8 supersedes it"
  },
  {
   "pattern": "\\bscreens designs\\b|\\badmitted as a SCREENING tool\\b",
   "why": "RSI admission is decided by P0-G6, which is open; an archive must not pre-adjudicate it"
  },
  {
   "pattern": "\\bthe saturation is physical\\b|\\bH1's mechanism is verified\\b",
   "why": "numerical-model-structural evidence described as physical validation"
  }
